<mxfile host="app.diagrams.net" type="device">
  <diagram id="list-and-sorting" name="BigNumberList and Sorting">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BigNumberList &amp; size-based sort selection" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="BigNumberList implements List&lt;BigNumber&gt; and adds statistical and numerical operations. sort() picks a SortingAlgorithm by size (chooseSortingAlgorithmBySize). An explicit algorithm can be passed via sort(Class). Verified against BigNumberList.java and algorithms/*." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="980" height="48" as="geometry" />
        </mxCell>

        <mxCell id="list" value="BigNumberList  implements List&lt;BigNumber&gt;&#10;&#10;factory: of(...), fromStrings(...)&#10;sort: sort(), sort(Class&lt;? extends SortingAlgorithm&gt;),&#10;      sortAscending(), sortDescending()&#10;stats: sum, average, median, modes, min, max, range,&#10;       variance, standardDeviation, geometricMean, harmonicMean&#10;in-place: absAll, negateAll, scale, translate, powEach,&#10;          clampAll, normalizeToSum, reverse&#10;functional: map, filter, distinct, append, subListCopy&#10;predicates: anyMatch, allMatch, findFirst,&#10;            isSortedAscending/Descending" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="430" height="320" as="geometry" />
        </mxCell>

        <!-- decision -->
        <mxCell id="dec" value="chooseSortingAlgorithmBySize(values)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="bubble" value="size ≤ 32&#10;→ BubbleSort" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="quick" value="33 … 999&#10;→ QuickSort" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="820" y="175" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="radix" value="≥ 1000 &amp; all integers&#10;→ RadixSort" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="820" y="230" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="≥ 1000 (else, decimals)&#10;→ MergeSort" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="820" y="285" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="algos" value="SortingAlgorithm (abstract) — 8 implementations:&#10;BubbleSort, InsertionSort, SelectionSort, GnomeSort,&#10;QuickSort, MergeSort, RadixSort, TimSort.&#10;sort(List&lt;BigNumber&gt;) returns sorted copy." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="360" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="es" value="sort() resolves class via" style="endArrow=open;html=1;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="list" target="dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb" style="endArrow=open;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="dec" target="bubble"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eq" style="endArrow=open;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="dec" target="quick"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er" style="endArrow=open;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="dec" target="radix"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em" style="endArrow=open;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="dec" target="merge"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Blue = public list type   Orange = selection decision   Purple = chosen algorithm   Grey = algorithm family" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
