<mxfile host="app.diagrams.net" type="device">
  <diagram id="unit-converter-architecture" name="UnitConverter Architecture">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="UnitConverter — Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="UnitConverter is the public API. Unit is a marker interface with 11 group enums (Length, Mass, Temperature, …). UnitRegistry is the single source of truth (BUILT_IN list) mapping each Unit to a UnitDefinition (display name, symbol, ConversionFormula). UnitElements is the lookup facade. Conversion always routes through the group base unit. Verified against converter/*." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1000" height="60" as="geometry" />
        </mxCell>

        <mxCell id="api" value="UnitConverter  (public API)&#10;convert(value, fromUnit, toUnit) → UnitValue&#10;convert(UnitValue, toUnit)&#10;convertToBigNumber(...)&#10;setMathContext(...)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="elem" value="UnitElements  (facade)&#10;parseUnit(symbol) → Unit&#10;getDisplayName(Unit)&#10;areCompatible(from, to)&#10;toBase(unit, value, ctx)&#10;fromBase(unit, base, ctx)&#10;findBySymbol(symbol)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="reg" value="UnitRegistry  (single source of truth)&#10;BUILT_IN : List&lt;UnitSpec&gt;&#10;findBySymbol(symbol)&#10;requireDefinition(unit) → UnitDefinition&#10;baseUnitOf(unit)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="140" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="unit" value="Unit  (marker interface)&#10;group enums: Length, Area, Volume, Mass,&#10;Temperature, Pressure, Energy, Power, Time,&#10;Force, Speed  (each with a base unit)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="def" value="UnitDefinition  (record)&#10;displayName, symbol, formula : ConversionFormula&#10;toBase(value, ctx) / fromBase(base, ctx)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="form" value="ConversionFormula  (strategy)&#10;toBase(BigNumber, MathContext)&#10;fromBase(BigNumber, MathContext)&#10;impls: AffineConversionFormula (base = v·scale + offset),&#10;RationalConversionFormula, ReciprocalConversionFormula,&#10;RationalReciprocalConversionFormula; built via ConversionFormulas" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="320" width="320" height="150" as="geometry" />
        </mxCell>

        <mxCell id="value" value="UnitValue  (numeric + unit)&#10;toDisplayString(...), toCompactString(...),&#10;toPrettyDisplayString(locale), compareTo(...)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="exc" value="exception.*&#10;UnitConversionException (incompatible / unknown unit),&#10;ConversionException (numeric parse failure)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="300" height="90" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="ea" value="uses" style="endArrow=open;html=1;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="api" target="elem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" value="looks up" style="endArrow=open;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="elem" target="reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" value="resolves" style="endArrow=open;html=1;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="reg" target="def"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed" value="holds" style="endArrow=open;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="def" target="form"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee" value="identifies" style="endArrow=open;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="def" target="unit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef" value="produces" style="endArrow=open;html=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="api" target="value"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eg" value="on error" style="endArrow=open;html=1;strokeColor=#b85450;dashed=1;fontSize=11;" edge="1" parent="1" source="api" target="exc"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Blue = public API   Green = result value   Yellow = registry/config   Orange = formula/parsing   Red = error   Grey = supporting types" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1100" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
