<mxfile host="app.diagrams.net" type="device">
  <diagram id="matrix-and-matrixmath" name="04 · BigNumberMatrix and MatrixMath">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1000" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="banner" value="BigNumberMatrix  ·  Matrix Type &amp; MatrixMath" style="rounded=1;arcSize=6;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=24;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=24;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1574" height="56" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="BigNumberMatrix is an immutable m×n matrix backed by data: List&lt;List&lt;BigNumber&gt;&gt; (row-major). Public operations validate dimensions / indices, then delegate the computation to static methods in MatrixMath. determinant uses Laplace expansion; inverse uses adjugate / determinant; power uses exponentiation by squaring. Verified against BigNumberMatrix.java and MatrixMath.java." style="text;html=1;fontColor=#475569;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="44" y="96" width="1560" height="56" as="geometry" />
        </mxCell>

        <!-- matrix card -->
        <mxCell id="mtx" value="BigNumberMatrix  (immutable)" style="swimlane;rounded=1;arcSize=4;html=1;startSize=34;fillColor=#3B82F6;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="740" height="700" as="geometry" />
        </mxCell>
        <mxCell id="mtx_f" value="&lt;b&gt;Fields&lt;/b&gt;&lt;br&gt;rows : BigNumber · columns : BigNumber · data : List&amp;lt;List&amp;lt;BigNumber&amp;gt;&amp;gt; · locale : Locale" style="text;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="44" width="712" height="48" as="geometry" />
        </mxCell>
        <mxCell id="mtx_c" value="&lt;b&gt;Construction&lt;/b&gt;&lt;br&gt;BigNumberMatrix(rows, columns, locale)&#160;— zero-filled · BigNumberMatrix(List&amp;lt;List&amp;gt;, locale) · BigNumberMatrix(&quot;1, 2; 3, 4&quot;, locale)&#160;— parsed · copy constructor" style="text;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="98" width="712" height="58" as="geometry" />
        </mxCell>
        <mxCell id="mtx_acc" value="&lt;b&gt;Element access&lt;/b&gt;&#160;(0-based, bounds-checked)&lt;br&gt;get(row, col) : BigNumber · set(row, col, value)" style="text;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="162" width="712" height="48" as="geometry" />
        </mxCell>
        <mxCell id="mtx_ops" value="&lt;b&gt;Arithmetic&lt;/b&gt;&#160;(return new matrix)&lt;br&gt;add · subtract · multiply (A.columns == B.rows) · divide (element-wise) · scalarMultiply(scalar)" style="text;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="216" width="712" height="56" as="geometry" />
        </mxCell>
        <mxCell id="mtx_tr" value="&lt;b&gt;Transform &amp;amp; compute&lt;/b&gt;&lt;br&gt;transpose · negate · power(exponent) · determinant · inverse · trace" style="text;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="278" width="712" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mtx_q" value="&lt;b&gt;Queries&lt;/b&gt;&lt;br&gt;isSquare · isSymmetric · isZeroMatrix · isIdentityMatrix · equalsMatrix(other)" style="text;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="334" width="712" height="48" as="geometry" />
        </mxCell>
        <mxCell id="mtx_ag" value="&lt;b&gt;Aggregate &amp;amp; iterate&lt;/b&gt;&lt;br&gt;sumElements · max · flatten · forEachElement(consumer) · forEachIndex(biConsumer)" style="text;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="388" width="712" height="48" as="geometry" />
        </mxCell>
        <mxCell id="mtx_out" value="&lt;b&gt;Output &amp;amp; copy&lt;/b&gt;&lt;br&gt;toString · toPlainDataString · clone" style="text;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="442" width="712" height="44" as="geometry" />
        </mxCell>
        <mxCell id="mtx_val" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;validateDimensions()&#160;— non-negative integers ≤ Integer.MAX_VALUE · validateIndex(index, max, type) · fillWithZeroes()" style="text;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="492" width="712" height="58" as="geometry" />
        </mxCell>
        <mxCell id="mtx_loc" value="&lt;b&gt;Locale / parsing&lt;/b&gt;&lt;br&gt;String form &quot;rows separated by ; , columns by ,&quot;; entries parsed as BigNumber in the given Locale" style="text;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="556" width="712" height="56" as="geometry" />
        </mxCell>
        <mxCell id="mtx_err" value="&lt;b&gt;Errors&lt;/b&gt;&lt;br&gt;dimension mismatch, non-square (determinant/inverse/trace), singular (inverse), index out of bounds → i18n matrix_errors via MatrixMessages" style="text;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mtx">
          <mxGeometry x="14" y="618" width="712" height="62" as="geometry" />
        </mxCell>

        <!-- MatrixMath card -->
        <mxCell id="mm" value="MatrixMath  (static helpers)" style="swimlane;rounded=1;arcSize=4;html=1;startSize=34;fillColor=#8B5CF6;strokeColor=#7C3AED;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;align=center;verticalAlign=middle;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="170" width="754" height="430" as="geometry" />
        </mxCell>
        <mxCell id="mm_ops" value="&lt;b&gt;Element-wise &amp;amp; product&lt;/b&gt;&lt;br&gt;add(a, b, locale) · subtract(a, b) · multiply(a, b)&#160;— standard product, A.columns == B.rows · divide(a, b)&#160;— element-wise · scalarMultiply(m, scalar)" style="text;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mm">
          <mxGeometry x="14" y="44" width="726" height="74" as="geometry" />
        </mxCell>
        <mxCell id="mm_tr" value="&lt;b&gt;Transform&lt;/b&gt;&lt;br&gt;transpose(m) · power(base, exponent)&#160;— exponentiation by squaring" style="text;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mm">
          <mxGeometry x="14" y="124" width="726" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mm_det" value="&lt;b&gt;Determinant&lt;/b&gt;&lt;br&gt;determinant(m)&#160;— Laplace expansion along the first row&lt;br&gt;base cases: 0×0 → 1 · 1×1 → value · 2×2 → ad − bc" style="text;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mm">
          <mxGeometry x="14" y="180" width="726" height="64" as="geometry" />
        </mxCell>
        <mxCell id="mm_inv" value="&lt;b&gt;Inverse&lt;/b&gt;&lt;br&gt;inverse(m) = adjugate(m) / determinant(m)&#160;— supporting: minor(m, row, col) · adjugate(m) · identity(size, locale)" style="text;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mm">
          <mxGeometry x="14" y="250" width="726" height="64" as="geometry" />
        </mxCell>
        <mxCell id="mm_note" value="&lt;b&gt;Precision&lt;/b&gt;&#160;— every cell value is a BigNumber, so determinant/inverse retain full arbitrary precision (no floating-point rounding beyond MathContext)." style="text;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" vertex="1" parent="mm">
          <mxGeometry x="14" y="320" width="726" height="92" as="geometry" />
        </mxCell>

        <mxCell id="seqlink" value="See diagram 14 for the step-by-step determinant sequence." style="text;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="620" width="754" height="40" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="validates, then delegates" style="endArrow=block;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#2563EB;strokeWidth=2;fontColor=#2563EB;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1" source="mtx" target="mm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:&#160;&#160;Blue = public matrix type&#160;&#160;·&#160;&#160;Violet = core math delegate&#160;&#160;·&#160;&#160;Orange = validation&#160;&#160;·&#160;&#160;Yellow = locale / precision note&#160;&#160;·&#160;&#160;Red = error path&#160;&#160;·&#160;&#160;Grey = queries / output" style="text;html=1;fontColor=#475569;fontSize=12;fontFamily=Helvetica;align=left;" vertex="1" parent="1">
          <mxGeometry x="44" y="900" width="1560" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
