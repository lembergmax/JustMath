        <mxCell id="title" value="JustMath — Overall Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Three top-level packages of com.mlprograms.justmath. The calculator package evaluates expression strings; bignumber provides the high-precision number model and math; converter handles unit conversion. All depend on BigNumber. Heavy transcendental math is delegated to the external library ch.obermuhlner.math.big.BigDecimalMath." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="54" as="geometry" />
        </mxCell>

        <!-- calculator package -->
        <mxCell id="pkg_calc" value="package calculator  (Expression engine)" style="swimlane;html=1;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="380" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c_engine" value="CalculatorEngine&#10;(public API)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pkg_calc">
          <mxGeometry x="110" y="40" width="160" height="44" as="geometry" />
        </mxCell>
