<mxfile host="app.diagrams.net" type="device">
  <diagram id="bignumber-and-math" name="BigNumber and Math">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BigNumber &amp; Math delegation" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="BigNumber is the central immutable high-precision number. Its instance methods are thin wrappers that delegate to static helper classes in package math.*. Roots, logarithms and trigonometry ultimately call the external library BigDecimalMath. MathContext (default precision 100, HALF_UP) controls precision." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="950" height="48" as="geometry" />
        </mxCell>

        <!-- BigNumber -->
        <mxCell id="bn" value="BigNumber  (Number, Comparable, Cloneable)&#10;&#10;fields: valueBeforeDecimalPoint, valueAfterDecimalPoint,&#10;        isNegative, locale, mathContext, trigonometricMode&#10;&#10;arithmetic: add, subtract, multiply, divide, modulo,&#10;            remainder, power, factorial, exp&#10;roots: squareRoot, cubicRoot, nthRoot&#10;logs: log2, log10, ln, logBase&#10;trig: sin, cos, tan, cot&#10;compare: isLessThan, isGreaterThan, isEqualTo, compareTo&#10;convert: toBigDecimal, isInteger, isNegative" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="380" height="300" as="geometry" />
        </mxCell>

        <mxCell id="consts" value="BigNumbers&#10;constants ZERO..TEN, NEGATIVE_ONE,&#10;pi(MathContext), e(MathContext),&#10;DEFAULT_MATH_CONTEXT, randomIntegerBigNumberInRange(...)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="parser" value="BigNumberParser&#10;parse(String[,Locale]), parseAndFormat(String,Locale),&#10;format(BigNumber,Locale), resolveLocale(String)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- math helpers -->
        <mxCell id="m1" value="BasicMath&#10;add, subtract, multiply, divide,&#10;modulo, remainder, power, factorial, exp&#10;(string-based decimal arithmetic)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="130" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="RadicalMath&#10;squareRoot, cubicRoot, nthRoot" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="232" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="LogarithmicMath&#10;log2, log10, ln, logBase" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="TrigonometricMath&#10;sin, cos, tan, cot  (DEG↔RAD via MathUtils.convertAngle)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="368" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="more: CalculusMath, CombinatoricsMath,&#10;StatisticsMath, NumberTheoryMath, SeriesMath,&#10;Inverse/Hyperbolic Trig, SpecialFunctionMath, …" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="436" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- external -->
        <mxCell id="ext" value="external: ch.obermuhlner.math.big.BigDecimalMath" style="rounded=0;html=1;whiteSpace=wrap;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="860" y="232" width="240" height="194" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="d1" value="delegates" style="endArrow=open;html=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="bn" target="m1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" style="endArrow=open;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="bn" target="m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d3" style="endArrow=open;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="bn" target="m3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d4" style="endArrow=open;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="bn" target="m4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d5" value="calls" style="endArrow=open;html=1;strokeColor=#666666;dashed=1;fontSize=11;" edge="1" parent="1" source="m2" target="ext"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d6" style="endArrow=open;html=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="m3" target="ext"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d7" style="endArrow=open;html=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="m4" target="ext"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Blue = central public number   Purple = core math delegate   Grey = utility / external   Yellow = constants" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
