<mxfile host="app.diagrams.net" type="device">
  <diagram id="calculator-engine-api" name="CalculatorEngine API">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CalculatorEngine — Public API surface" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="The single public entry class. Four method families differ only in how they report results; all share the same evaluation pipeline. Builder-style setters configure locale, error formatting and the token cache. Verified against CalculatorEngine.java." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="44" as="geometry" />
        </mxCell>

        <!-- API family: throwing -->
        <mxCell id="f1" value="1) Throwing API  →  BigNumber&#10;&#10;evaluate(String)&#10;evaluate(String, Map&lt;String,String&gt; variables)&#10;&#10;Throws CalculatorException on any error." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- API family: to string -->
        <mxCell id="f2" value="2) Text API  →  String&#10;&#10;evaluateToString(...)&#10;evaluateToPrettyString(...)&#10;&#10;Each with and without a variables Map. Locale-aware formatting; pretty adds grouping." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- API family: safe string -->
        <mxCell id="f3" value="3) Safe text API  →  String (null-tolerant)&#10;&#10;evaluateSafeToString(...)&#10;evaluateSafeToPrettyString(...)&#10;&#10;Never throws; returns localized &quot;Error: &quot; / &quot;Fehler: &quot; prefix on failure." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="290" height="150" as="geometry" />
        </mxCell>

        <!-- API family: result -->
        <mxCell id="f4" value="4) Typed Result API  →  CalculatorResult&lt;T&gt;&#10;&#10;evaluateSafe(...)  → CalculatorResult&lt;BigNumber&gt;&#10;evaluateToStringResult(...)  → CalculatorResult&lt;String&gt;&#10;evaluateToPrettyStringResult(...)&#10;&#10;Functional Success/Failure handling, no exceptions." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="950" y="120" width="300" height="150" as="geometry" />
        </mxCell>

        <!-- Configuration -->
        <mxCell id="cfg" value="Builder-style configuration (return CalculatorEngine)&#10;&#10;setLocale(Locale)            — output separators &amp; error language&#10;setErrorMode(ErrorMode)      — RAW | USER_FRIENDLY&#10;setExpressionCacheEnabled(boolean)&#10;setExpressionCacheSize(int)  — LRU capacity (default 128)&#10;&#10;Constructors accept MathContext (default precision 100) and TrigonometricMode (default DEG)." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="580" height="180" as="geometry" />
        </mxCell>

        <!-- supporting types -->
        <mxCell id="t_res" value="CalculatorResult&lt;T&gt;  (sealed)&#10;&#10;Success&lt;T&gt;(T value)&#10;Failure&lt;T&gt;(CalculatorError error)&#10;&#10;isSuccess() / isFailure()&#10;value() / error()&#10;valueOrThrow()&#10;map(Function)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="t_enums" value="ErrorMode { RAW, USER_FRIENDLY }&#10;TrigonometricMode { DEG, RAD }&#10;&#10;internal state:&#10;  Map&lt;String,List&lt;Token&gt;&gt; expressionCache&#10;  ThreadLocal&lt;Map&lt;String,String&gt;&gt; currentVariables" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="930" y="300" width="320" height="180" as="geometry" />
        </mxCell>

        <!-- legend -->
        <mxCell id="leg" value="Legend:  Blue = throwing/eager API   Green = safe (no-throw) API   Yellow = configuration   Grey = supporting types" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
