<mxfile host="app.diagrams.net" type="device">
  <diagram id="matrix-and-matrixmath" name="BigNumberMatrix and MatrixMath">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BigNumberMatrix &amp; MatrixMath" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="BigNumberMatrix is an immutable m×n matrix (data: List&lt;List&lt;BigNumber&gt;&gt;). Public operations validate dimensions, then delegate the actual computation to static methods in MatrixMath. determinant uses Laplace expansion; inverse uses adjugate / determinant. Verified against BigNumberMatrix.java and MatrixMath.java." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="980" height="50" as="geometry" />
        </mxCell>

        <mxCell id="mtx" value="BigNumberMatrix  (immutable)&#10;&#10;fields: rows, columns, data: List&lt;List&lt;BigNumber&gt;&gt;, locale&#10;&#10;construct: (rows,cols,locale) | (List&lt;List&gt;,locale) |&#10;           (matrixString &quot;1,2;3,4&quot;,locale) | copy&#10;access: get(r,c), set(r,c,v)  (bounds-checked)&#10;ops: add, subtract, multiply, divide, scalarMultiply&#10;transform: transpose, negate, power&#10;compute: determinant, inverse, trace&#10;query: isSquare, isSymmetric, isIdentityMatrix, isZeroMatrix&#10;aggregate: sumElements, max, flatten&#10;iterate: forEachElement, forEachIndex" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="430" height="360" as="geometry" />
        </mxCell>

        <mxCell id="mm" value="MatrixMath  (static helpers)&#10;&#10;add(a,b,locale) / subtract(a,b)&#10;multiply(a,b)        — A.columns == B.rows&#10;divide(a,b)          — element-wise&#10;scalarMultiply(m,scalar)&#10;transpose(m)&#10;determinant(m)       — Laplace expansion&#10;inverse(m)           — adjugate(m) / determinant(m)&#10;power(base,exponent) — exponentiation by squaring&#10;minor(m,row,col)&#10;adjugate(m)&#10;identity(size,locale)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="420" height="360" as="geometry" />
        </mxCell>

        <mxCell id="val" value="validateDimensions() / validateIndex(...)&#10;run before delegation; throw on bad shape/index" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="430" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="delegates computation" style="endArrow=open;html=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="mtx" target="mm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="leg" value="Legend:  Blue = public matrix type   Purple = core math delegate   Orange = validation" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
