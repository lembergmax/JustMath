          <mxGeometry x="730" y="130" width="180" height="620" as="geometry" />
        </mxCell>
        <mxCell id="ll_err" value="CalculatorError" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1010" y="130" width="160" height="620" as="geometry" />
        </mxCell>

