        <mxCell id="title" value="Sequence — evaluateSafe(&quot;1/0&quot;)  →  Failure" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="950" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="A processing error (division by zero) on the safe Result API. The Evaluator raises ProcessingErrorException carrying CalculatorErrorCode.PROCESSING_DIVISION_BY_ZERO; CalculatorEngine catches it and returns CalculatorResult.Failure instead of throwing. The caller renders the message via CalculatorError.format(locale, errorMode). Verified against Evaluator, exceptions/*, errors/*." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1080" height="62" as="geometry" />
        </mxCell>

        <mxCell id="ll_caller" value="Caller" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="120" height="620" as="geometry" />
        </mxCell>
        <mxCell id="ll_engine" value="CalculatorEngine" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="150" height="620" as="geometry" />
        </mxCell>
        <mxCell id="ll_eval" value="Evaluator" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="520" y="130" width="120" height="620" as="geometry" />
        </mxCell>
