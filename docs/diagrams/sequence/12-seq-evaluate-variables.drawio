<mxfile host="app.diagrams.net" type="device">
  <diagram id="seq-evaluate-variables" name="Sequence: evaluate with variables">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sequence — evaluate(&quot;2*x+y&quot;, {x=3, y=4})  →  10" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="950" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Evaluation with a variable map. Before parsing, CalculatorEngineUtils checks for cyclic variable references and then substitutes VARIABLE tokens with their evaluated values. A variable cycle would raise CyclicVariableReferenceException. Verified against CalculatorEngine and CalculatorEngineUtils." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1050" height="48" as="geometry" />
        </mxCell>

        <mxCell id="ll_caller" value="Caller" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="120" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ll_engine" value="CalculatorEngine" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="150" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ll_tok" value="Tokenizer" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="120" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ll_utils" value="CalculatorEngineUtils" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="730" y="120" width="160" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ll_eval" value="PostfixParser + Evaluator" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="980" y="120" width="200" height="600" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1: evaluate(&quot;2*x+y&quot;, {x=3, y=4})" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="200" as="sourcePoint" /><mxPoint x="355" y="200" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2: tokenize(&quot;2*x+y&quot;)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="240" as="sourcePoint" /><mxPoint x="580" y="240" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3: [2, *, x, +, y]" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="580" y="280" as="sourcePoint" /><mxPoint x="355" y="280" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: checkVariablesForRecursion({x,y})" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="320" as="sourcePoint" /><mxPoint x="810" y="320" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5: replaceVariables(tokens, {x=3, y=4})" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="370" as="sourcePoint" /><mxPoint x="810" y="370" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6: [2, *, 3, +, 4]  (substituted)" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="810" y="410" as="sourcePoint" /><mxPoint x="355" y="410" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7: toPostfix → [2,3,*,4,+]  then evaluate" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="460" as="sourcePoint" /><mxPoint x="1080" y="460" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8: BigNumber(10)" style="html=1;endArrow=open;dashed=1;fontSize=11;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="510" as="sourcePoint" /><mxPoint x="355" y="510" as="targetPoint" /></mxGeometry>
