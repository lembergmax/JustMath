        <mxCell id="leg" value="Legend:  solid arrow = call   dashed arrow = return   green = result   (cycle would raise CyclicVariableReferenceException)" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1050" height="24" as="geometry" />
        </mxCell>
