<mxfile host="app.diagrams.net" type="device">
  <diagram id="seq-matrix-operation" name="Sequence: matrix determinant">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sequence — BigNumberMatrix.determinant()" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="950" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Determinant via Laplace expansion. BigNumberMatrix validates the shape (must be square) then delegates to MatrixMath.determinant, which expands recursively using minor(...) and combines cofactors with BigNumber arithmetic. The same delegate pattern applies to multiply / inverse / power. Verified against BigNumberMatrix.java and MatrixMath.java." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1080" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ll_caller" value="Caller" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="120" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ll_mtx" value="BigNumberMatrix" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="130" width="160" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ll_mm" value="MatrixMath" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="580" y="130" width="160" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ll_bn" value="BigNumber" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="870" y="130" width="140" height="600" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1: determinant()" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="210" as="sourcePoint" /><mxPoint x="380" y="210" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n1" value="self: validateDimensions() / require square (isSquare)" style="text;html=1;fontSize=10;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="320" height="26" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2: determinant(this)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="380" y="280" as="sourcePoint" /><mxPoint x="660" y="280" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n2" value="self: Laplace expansion along first row — for each column j: minor(m,0,j) then recurse determinant(minor)" style="text;html=1;fontSize=10;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="430" height="26" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3: multiply / subtract cofactor terms" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="350" as="sourcePoint" /><mxPoint x="940" y="350" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: BigNumber (partial sums)" style="html=1;endArrow=open;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="940" y="390" as="sourcePoint" /><mxPoint x="660" y="390" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5: BigNumber det" style="html=1;endArrow=open;dashed=1;fontSize=11;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="440" as="sourcePoint" /><mxPoint x="380" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6: return BigNumber det" style="html=1;endArrow=open;dashed=1;fontSize=11;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="380" y="480" as="sourcePoint" /><mxPoint x="120" y="480" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="leg" value="Legend:  solid arrow = call   dashed arrow = return   green = result   orange note = validation   purple note = recursive algorithm" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1080" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
