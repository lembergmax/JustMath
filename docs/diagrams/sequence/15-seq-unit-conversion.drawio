<mxfile host="app.diagrams.net" type="device">
  <diagram id="seq-unit-conversion" name="Sequence: unit conversion">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sequence — convert(5, KILOMETER, METER)  →  5000 m" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Every conversion routes through the group base unit. UnitConverter first checks compatibility (same unit group), then normalizes the source value to the base unit (toBase) and scales it to the target unit (fromBase). Both steps run the ConversionFormula stored in the target UnitDefinition. Incompatible units raise UnitConversionException. Verified against UnitConverter, UnitElements, UnitRegistry, ConversionFormula." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1100" height="64" as="geometry" />
        </mxCell>

        <mxCell id="ll_caller" value="Caller" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="120" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_conv" value="UnitConverter" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="150" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_elem" value="UnitElements" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="130" width="140" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_reg" value="UnitRegistry" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="730" y="130" width="140" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_form" value="ConversionFormula" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=34;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="950" y="130" width="170" height="640" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1: convert(5, KILOMETER, METER)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="120" y="210" as="sourcePoint" /><mxPoint x="355" y="210" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2: areCompatible(KILOMETER, METER) → true" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="250" as="sourcePoint" /><mxPoint x="590" y="250" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3: requireDefinition(unit)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="290" as="sourcePoint" /><mxPoint x="800" y="290" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: toBase(KILOMETER, 5, ctx)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="340" as="sourcePoint" /><mxPoint x="590" y="340" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5: formula.toBase(5, ctx) → 5000 (base = m)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="380" as="sourcePoint" /><mxPoint x="1035" y="380" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6: fromBase(METER, 5000, ctx)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="430" as="sourcePoint" /><mxPoint x="590" y="430" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7: formula.fromBase(5000, ctx) → 5000 m" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="470" as="sourcePoint" /><mxPoint x="1035" y="470" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8: return UnitValue(5000, METER)" style="html=1;endArrow=open;dashed=1;fontSize=11;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="520" as="sourcePoint" /><mxPoint x="120" y="520" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="leg" value="Legend:  solid arrow = call   dashed arrow = return   green = result   yellow/orange = registry &amp; formula   (incompatible → UnitConversionException)" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1100" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
