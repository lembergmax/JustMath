<mxfile host="app.diagrams.net" type="device">
  <diagram id="detailed-trace-function-unary" name="Detailed Trace: function + unary">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Detailed Evaluation Trace — evaluate(&quot;sqrt(16) + -3^2&quot;)  →  -5" style="rounded=1;arcSize=8;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=22;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Companion to diagram 18, covering a function call (sqrt), a prefix unary minus and the only right-associative operator (^). Key insight: &quot;-3^2&quot; parses as -(3^2), NOT (-3)^2. The unary minus is tokenized as a separate UNARY_OPERATOR (never folded into the number); it has precedence 4 and is right-associative, exactly like ^. When ^ arrives with the unary - on top of the operator stack (equal precedence 4), the right-associativity of ^ prevents the pop — so ^ is pushed ABOVE the unary minus and is evaluated first. FUNCTION tokens are pushed to the operator stack and emitted when their closing ) is reached. Verified in ExpressionElements (sqrt prec 4; ^ = BinaryOperator prec 4; unary - = PostfixUnaryOperator prec 4), Token.asArithmeticOperator, PostfixParser and Evaluator." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="tok" value="Tokenizer.tokenize(&quot;sqrt(16) + -3^2&quot;)  →  [ sqrt, (, 16, ), +, -(unary), 3, ^, 2 ]    (the leading - after binary + is a UNARY_OPERATOR sign token)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="178" width="1500" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="Phase 1 — Shunting-Yard (PostfixParser.toPostfix)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
