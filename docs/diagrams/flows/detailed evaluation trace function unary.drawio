        <mxCell id="e6b" value="- (unary)" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="90" y="1060" width="80" height="44" as="geometry" /></mxCell>
        <mxCell id="e6c" value="UNARY_OPERATOR: pop one = 9 → push negate(9) = -9   (this is the &quot;-&quot; of -(3^2))" style="rounded=0;html=1;fillColor=#fff;strokeColor=#666;align=left;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="170" y="1060" width="620" height="44" as="geometry" /></mxCell>
        <mxCell id="e6d" value="4 -9" style="rounded=0;html=1;fillColor=#fff;strokeColor=#666;fontFamily=Courier New;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="790" y="1060" width="420" height="44" as="geometry" /></mxCell>

        <mxCell id="e7a" value="7" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666;" vertex="1" parent="1"><mxGeometry x="40" y="1104" width="50" height="44" as="geometry" /></mxCell>
        <mxCell id="e7b" value="+" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="90" y="1104" width="80" height="44" as="geometry" /></mxCell>
        <mxCell id="e7c" value="OPERATOR: b = pop() = -9, a = pop() = 4 → push a+b = 4+(-9) = -5" style="rounded=0;html=1;fillColor=#fff;strokeColor=#666;align=left;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="170" y="1104" width="620" height="44" as="geometry" /></mxCell>
        <mxCell id="e7d" value="-5" style="rounded=0;html=1;fillColor=#fff;strokeColor=#666;fontFamily=Courier New;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="790" y="1104" width="420" height="44" as="geometry" /></mxCell>

        <mxCell id="e8a" value="end" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666;" vertex="1" parent="1"><mxGeometry x="40" y="1148" width="50" height="44" as="geometry" /></mxCell>
        <mxCell id="e8b" value="—" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="90" y="1148" width="80" height="44" as="geometry" /></mxCell>
        <mxCell id="e8c" value="No tokens left → stack.size() == 1 → pop() → result" style="rounded=0;html=1;fillColor=#fff;strokeColor=#666;align=left;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="170" y="1148" width="620" height="44" as="geometry" /></mxCell>
        <mxCell id="e8d" value="BigNumber(-5)  ← result" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontFamily=Courier New;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="790" y="1148" width="420" height="44" as="geometry" /></mxCell>

        <!-- insight box -->
        <mxCell id="insight" value="Why -(3^2) and not (-3)^2?&#10;&#10;Both unary - and ^ have precedence 4 and are right-associative.&#10;When ^ arrives, the equal-precedence pop is skipped for a&#10;right-associative incoming operator, so ^ stacks above the&#10;unary minus. In RPN the order becomes 3 2 ^ first, then the&#10;unary - is applied to the result → -(3^2) = -9.&#10;&#10;The unary - is never merged into the number 3; the Tokenizer&#10;always emits it as a separate UNARY_OPERATOR." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="852" width="320" height="240" as="geometry" />
        </mxCell>

        <mxCell id="leg" value="Legend:  Blue token = operand pushed   Purple token = operator/function applied   Yellow = parenthesis / rule   Green = final result   Monospace columns show live data-structure state." style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1210" width="1500" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
