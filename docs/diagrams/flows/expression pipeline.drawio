        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;5 · To postfix&lt;/b&gt;  PostfixParser.toPostfix(tokens) → List&amp;lt;Token&amp;gt; (RPN)&lt;br&gt;Shunting-Yard; precedence + associativity (^ right-assoc)" vertex="1">
          <mxGeometry height="60" width="460" x="420" y="600" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;6 · Validate arity&lt;/b&gt;  validatePostfixArity(postfix)&lt;br&gt;stack-based dry run checks operand counts before evaluation" vertex="1">
