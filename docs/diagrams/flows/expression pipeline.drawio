        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;1 · Normalize&lt;/b&gt;  CalculatorEngineUtils.replaceAbsSigns(...)&lt;br&gt;|x| → abs(x); validates an even number of bars" vertex="1">
          <mxGeometry height="56" width="460" x="420" y="248" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;2 · Tokenize&lt;/b&gt;  Tokenizer.tokenize(...) → List&amp;lt;Token&amp;gt;&lt;br&gt;numbers · operators · unary signs · functions · parens · ; · implicit ×" vertex="1">
          <mxGeometry height="56" width="460" x="420" y="334" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;3 · Resolve variables&lt;/b&gt;  CalculatorEngineUtils&lt;br&gt;checkVariablesForRecursion(...) · replaceVariables(...) substitute VARIABLE tokens" vertex="1">
          <mxGeometry height="60" width="460" x="420" y="420" as="geometry" />
