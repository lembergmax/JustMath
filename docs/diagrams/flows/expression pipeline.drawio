        <mxCell id="s4" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;4 · Validate infix&lt;/b&gt;  validateInfixStructure(tokens)&lt;br&gt;empty fn args · bare () · leading/trailing operators · missing operators · arg counts" vertex="1">
