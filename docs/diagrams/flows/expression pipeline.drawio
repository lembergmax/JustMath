        <mxCell id="s0" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;Input&lt;/b&gt;  String expression  (+ optional Map&amp;lt;String,String&amp;gt; variables)" vertex="1">
