        <mxCell id="errb" parent="err" style="text;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;SyntaxErrorException&lt;/b&gt; (stages 1–6)&lt;br&gt;INVALID_CHARACTER · UNMATCHED_PAREN · UNKNOWN_FUNCTION · UNKNOWN_VARIABLE · WRONG_ARGUMENT_COUNT · MISPLACED_SEPARATOR · MISSING_OPERAND/OPERATOR · LEADING/TRAILING_OPERATOR · EMPTY_PARENTHESES …&lt;br&gt;&lt;br&gt;&lt;b&gt;ProcessingErrorException&lt;/b&gt; (stage 7)&lt;br&gt;DIVISION_BY_ZERO · DOMAIN_ERROR · LOG_NON_POSITIVE · ROOT_OF_NEGATIVE · FACTORIAL_NEGATIVE / NON_INTEGER · OVERFLOW · INTERNAL&lt;br&gt;&lt;br&gt;&lt;b&gt;CyclicVariableReferenceException&lt;/b&gt; (stage 3)&lt;br&gt;&lt;br&gt;&lt;i&gt;Handed to the API boundary → throw, or CalculatorResult.Failure. See diagram 08.&lt;/i&gt;" vertex="1">
