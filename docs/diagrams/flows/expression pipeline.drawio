        <mxCell id="cache" parent="1" style="swimlane;rounded=1;arcSize=4;html=1;startSize=28;fillColor=#F59E0B;strokeColor=#D97706;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;swimlaneFillColor=#FFFFFF;shadow=1;" value="LRU Token Cache  (optional)" vertex="1">
