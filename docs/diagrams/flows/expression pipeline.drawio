        <mxCell id="err" parent="1" style="swimlane;rounded=1;arcSize=4;html=1;startSize=28;fillColor=#EF4444;strokeColor=#DC2626;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;swimlaneFillColor=#FFFFFF;shadow=1;" value="Error Path" vertex="1">
