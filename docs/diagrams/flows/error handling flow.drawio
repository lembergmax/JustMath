          <mxGeometry height="56" width="360" x="60" y="724" as="geometry" />
        </mxCell>
        <mxCell id="uf" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;ErrorMode.USER_FRIENDLY&lt;/b&gt;&lt;br&gt;ResourceBundle i18n.calculator_errors (+_en / _de)&lt;br&gt;tiered lookup: specific code key → category key → generic → fallback technicalDetail&lt;br&gt;substitute named placeholders {character} {function} {variable} {operator} {position} …" vertex="1">
