<mxfile host="Electron">
  <diagram id="error-handling-flow" name="08 · Error Handling Flow">
    <mxGraphModel dx="2445" dy="1001" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1100" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" parent="1" style="rounded=1;arcSize=6;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=24;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=24;shadow=1;" value="Error Handling Flow" vertex="1">
          <mxGeometry height="56" width="1574" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontColor=#475569;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" value="A failure is classified into a CalculatorErrorCode (23 codes, 5 categories), wrapped in a CalculatorError record, then surfaced as an exception (throwing API) or a CalculatorResult.Failure (safe API). CalculatorError.format(Locale, ErrorMode) renders the message — RAW = technical English; USER_FRIENDLY = localized template from the i18n bundle. Verified against errors/* and exceptions/*." vertex="1">
          <mxGeometry height="56" width="1560" x="44" y="96" as="geometry" />
        </mxCell>
        <mxCell id="src" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;Failure detected in pipeline&lt;/b&gt;&lt;br&gt;tokenize · validate · toPostfix · evaluate" vertex="1">
          <mxGeometry height="56" width="320" x="60" y="180" as="geometry" />
        </mxCell>
        <mxCell id="code" parent="1" style="swimlane;rounded=1;arcSize=4;html=1;startSize=30;fillColor=#EF4444;strokeColor=#DC2626;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;swimlaneFillColor=#FFFFFF;shadow=1;" value="CalculatorErrorCode  ·  23 codes / 5 categories" vertex="1">
          <mxGeometry height="360" width="360" x="40" y="280" as="geometry" />
        </mxCell>
        <mxCell id="code_syn" parent="code" style="text;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;Syntax&lt;/b&gt; INVALID_CHARACTER · MISSING_RIGHT_PAREN · UNMATCHED_PAREN · UNKNOWN_FUNCTION · UNKNOWN_VARIABLE · INCOMPLETE_EXPRESSION · TRAILING/LEADING_OPERATOR · MISSING_OPERAND/OPERATOR · EMPTY_PARENTHESES · EMPTY_FUNCTION_ARGUMENT · UNEXPECTED_END · WRONG_ARGUMENT_COUNT · MISPLACED_SEPARATOR · INVALID_FACTORIAL" vertex="1">
          <mxGeometry height="150" width="336" x="12" y="38" as="geometry" />
        </mxCell>
        <mxCell id="code_rest" parent="code" style="text;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" value="&lt;b&gt;Argument&lt;/b&gt; COUNT_MISMATCH&lt;br&gt;&lt;b&gt;Math&lt;/b&gt; DIVISION_BY_ZERO · DOMAIN_ERROR · FACTORIAL_NEGATIVE · FACTORIAL_NON_INTEGER · LOG_NON_POSITIVE · ROOT_OF_NEGATIVE&lt;br&gt;&lt;b&gt;Range&lt;/b&gt; OVERFLOW&lt;br&gt;&lt;b&gt;Processing&lt;/b&gt; INTERNAL" vertex="1">
          <mxGeometry height="152" width="336" x="12" y="196" as="geometry" />
        </mxCell>
        <mxCell id="cerr" parent="1" style="swimlane;rounded=1;arcSize=4;html=1;startSize=30;fillColor=#EF4444;strokeColor=#DC2626;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;swimlaneFillColor=#FFFFFF;shadow=1;" value="CalculatorError  (record)" vertex="1">
          <mxGeometry height="120" width="360" x="440" y="250" as="geometry" />
        </mxCell>
        <mxCell id="cerrb" parent="cerr" style="text;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=8;spacingTop=6;spacingRight=8;" value="code : CalculatorErrorCode · params : Map · technicalDetail : String · position : Integer&lt;br&gt;BUNDLE_BASENAME = &quot;i18n.calculator_errors&quot;" vertex="1">
          <mxGeometry height="70" width="336" x="12" y="38" as="geometry" />
        </mxCell>
        <mxCell id="dec" parent="1" style="rhombus;rounded=0;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;whiteSpace=wrap;shadow=1;" value="Which API was called?" vertex="1">
          <mxGeometry height="110" width="240" x="500" y="450" as="geometry" />
        </mxCell>
        <mxCell id="throw" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;Throwing API&lt;/b&gt; (evaluate, …)&lt;br&gt;→ SyntaxErrorException or ProcessingErrorException&lt;br&gt;(both extend CalculatorException, carry the CalculatorError)" vertex="1">
