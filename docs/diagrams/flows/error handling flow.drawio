        <mxCell id="result" parent="1" style="rounded=1;arcSize=10;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" value="&lt;b&gt;Safe API&lt;/b&gt; (evaluateSafe, …)&lt;br&gt;→ CalculatorResult.Failure(error) (sealed; vs. Success)" vertex="1">
          <mxGeometry height="70" width="380" x="890" y="520" as="geometry" />
        </mxCell>
        <mxCell id="fmt" parent="1" style="rhombus;rounded=0;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;whiteSpace=wrap;shadow=1;" value="CalculatorError.format(Locale, ErrorMode)" vertex="1">
