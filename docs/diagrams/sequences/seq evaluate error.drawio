        </mxCell>
        <mxCell id="ll_expr" value="ExpressionElements (&quot;/&quot;)" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="730" y="150" width="180" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_err" value="CalculatorError" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#EF4444;strokeColor=#DC2626;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
