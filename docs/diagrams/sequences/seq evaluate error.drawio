  <diagram id="seq-evaluate-error" name="13 · Sequence: evaluate error case">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="1">
      <root>
