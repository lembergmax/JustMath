        <mxCell id="banner" value="Sequence — evaluateSafe(&quot;1/0&quot;)  →  Failure" style="rounded=1;arcSize=6;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=24;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=24;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A processing error (division by zero) on the safe Result API. The Evaluator raises ProcessingErrorException carrying PROCESSING_DIVISION_BY_ZERO; CalculatorEngine catches it and returns CalculatorResult.Failure instead of throwing. The caller renders the message via CalculatorError.format(locale, errorMode). Verified against Evaluator, exceptions/*, errors/*." style="text;html=1;fontColor=#475569;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="44" y="84" width="1416" height="56" as="geometry" />
        </mxCell>

        <mxCell id="ll_caller" value="Caller" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#3B82F6;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="130" height="640" as="geometry" />
        </mxCell>
