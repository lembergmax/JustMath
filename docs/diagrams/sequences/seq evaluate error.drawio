        <mxCell id="m3" value="3: apply &quot;/&quot; (1, 0)" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
