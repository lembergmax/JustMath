        <mxCell id="note" value="The throwing API (evaluate) would instead let the ProcessingErrorException escape to the caller. See diagram 08." style="rounded=1;arcSize=12;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=10;shadow=1;" vertex="1" parent="1">
