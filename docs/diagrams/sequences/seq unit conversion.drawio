<mxfile host="app.diagrams.net" type="device">
  <diagram id="seq-unit-conversion" name="15 · Sequence: unit conversion">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="banner" value="Sequence — convert(5, KILOMETER, METER)  →  5000 m" style="rounded=1;arcSize=6;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=24;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=24;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Every conversion routes through the group base unit. UnitConverter first checks compatibility (same unit group), then normalizes the source value to the base unit (toBase) and scales it to the target unit (fromBase). Both steps run the ConversionFormula stored in the target UnitDefinition. Incompatible units raise UnitConversionException. Verified against UnitConverter, UnitElements, UnitRegistry, ConversionFormula." style="text;html=1;fontColor=#475569;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="44" y="84" width="1416" height="56" as="geometry" />
        </mxCell>

        <mxCell id="ll_caller" value="Caller" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#3B82F6;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="130" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_conv" value="UnitConverter" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#3B82F6;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="150" width="160" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_elem" value="UnitElements" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="140" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_reg" value="UnitRegistry" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#F59E0B;strokeColor=#D97706;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="730" y="150" width="140" height="640" as="geometry" />
        </mxCell>
        <mxCell id="ll_form" value="ConversionFormula" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#F97316;strokeColor=#EA580C;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="950" y="150" width="170" height="640" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1: convert(5, KILOMETER, METER)" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="125" y="230" as="sourcePoint" /><mxPoint x="360" y="230" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2: areCompatible(KILOMETER, METER) → true" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="360" y="270" as="sourcePoint" /><mxPoint x="590" y="270" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3: requireDefinition(unit)" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="310" as="sourcePoint" /><mxPoint x="800" y="310" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: toBase(KILOMETER, 5, ctx)" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="360" y="360" as="sourcePoint" /><mxPoint x="590" y="360" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5: formula.toBase(5, ctx) → 5000  (base = m)" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="400" as="sourcePoint" /><mxPoint x="1035" y="400" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6: fromBase(METER, 5000, ctx)" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="360" y="450" as="sourcePoint" /><mxPoint x="590" y="450" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7: formula.fromBase(5000, ctx) → 5000 m" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="590" y="490" as="sourcePoint" /><mxPoint x="1035" y="490" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8: return UnitValue(5000, METER)" style="html=1;rounded=1;endArrow=open;dashed=1;dashPattern=6 4;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="360" y="540" as="sourcePoint" /><mxPoint x="125" y="540" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="note" value="If areCompatible returns false (different unit group) or the symbol is unknown, UnitConverter raises UnitConversionException at step 2 — no toBase/fromBase run. Affine units (e.g. Temperature) apply base = value·scale + offset." style="rounded=1;arcSize=12;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#7F1D1D;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="600" width="840" height="56" as="geometry" />
        </mxCell>

        <mxCell id="leg" value="Legend:&#160;&#160;solid arrow = call&#160;&#160;·&#160;&#160;dashed arrow = return&#160;&#160;·&#160;&#160;green = result&#160;&#160;·&#160;&#160;yellow / orange = registry &amp; formula&#160;&#160;·&#160;&#160;red note = error condition" style="text;html=1;fontColor=#475569;fontSize=12;fontFamily=Helvetica;align=left;" vertex="1" parent="1">
          <mxGeometry x="44" y="810" width="1400" height="24" as="geometry" />
