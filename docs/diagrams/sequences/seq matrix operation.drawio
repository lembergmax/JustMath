        <mxCell id="m1" value="1: determinant()" style="html=1;rounded=1;endArrow=block;strokeColor=#334155;strokeWidth=2;fontColor=#1E293B;fontSize=11;fontFamily=Helvetica;" edge="1" parent="1">
