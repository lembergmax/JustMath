        </mxCell>
        <mxCell id="n2" value="self · Laplace expansion along first row — for each column j: minor(m,0,j) then recurse determinant(minor)" style="rounded=1;arcSize=12;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=8;shadow=1;" vertex="1" parent="1">
