        <mxCell id="banner" value="Sequence — BigNumberMatrix.determinant()" style="rounded=1;arcSize=6;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=24;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=24;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1320" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Determinant via Laplace expansion. BigNumberMatrix validates the shape (must be square) then delegates to MatrixMath.determinant, which expands recursively using minor(...) and combines cofactors with BigNumber arithmetic. The same delegate pattern applies to multiply / inverse / power. Verified against BigNumberMatrix.java and MatrixMath.java." style="text;html=1;fontColor=#475569;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="44" y="84" width="1316" height="56" as="geometry" />
        </mxCell>

        <mxCell id="ll_caller" value="Caller" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;size=40;rounded=1;arcSize=18;fillColor=#3B82F6;strokeColor=#2563EB;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="130" height="600" as="geometry" />
        </mxCell>
