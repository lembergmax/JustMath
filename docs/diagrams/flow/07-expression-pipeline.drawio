<mxfile host="app.diagrams.net" type="device">
  <diagram id="expression-pipeline" name="Expression Pipeline">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Expression Evaluation Pipeline" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Data flow from input string to BigNumber inside CalculatorEngine.evaluate(...). Reading top → bottom. Optional steps (cache, variables) are shown on the side. Any stage may raise a SyntaxErrorException or ProcessingErrorException (red path). Verified against CalculatorEngine.java, Tokenizer.java, PostfixParser.java, Evaluator.java, CalculatorEngineUtils.java." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="820" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s0" value="Input: String expression&#10;(+ optional Map&lt;String,String&gt; variables)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="130" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="CalculatorEngineUtils.replaceAbsSigns(...)&#10;normalize  |x|  →  abs(x)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="210" width="320" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Tokenizer.tokenize(normalized)&#10;→ List&lt;Token&gt;  (numbers, operators, unary signs,&#10;functions, parens, ; ; implicit multiplication inserted)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="286" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="CalculatorEngineUtils.replaceVariables(...)&#10;substitute VARIABLE tokens;&#10;checkVariablesForRecursion(...) guards cycles" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="376" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="CalculatorEngineUtils.validateInfixStructure(tokens)&#10;reject empty fn args, bare (), leading/trailing operators,&#10;missing operators, wrong argument counts" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="466" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="PostfixParser.toPostfix(tokens)&#10;Shunting-Yard → List&lt;Token&gt; in RPN&#10;(precedence; ^ right-associative)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="556" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="CalculatorEngineUtils.validatePostfixArity(postfix)&#10;stack-based dry run checks operand counts" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="646" width="320" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="Evaluator.evaluate(postfix)&#10;RPN stack machine; resolves each Token via&#10;ExpressionElements registry; element.apply(stack, ctx, trigMode, locale)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="722" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="Result: BigNumber&#10;(MultiValueResult coerced via firstValue() if used as scalar)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="120" y="816" width="320" height="56" as="geometry" />
        </mxCell>

        <!-- side: cache -->
        <mxCell id="cache" value="Optional LRU token cache&#10;(if enabled): lookupCache(key) before tokenizing,&#10;storeCache(key, tokens) after.&#10;Key = normalized expression; tokens cached&#10;BEFORE variable substitution." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="320" height="120" as="geometry" />
        </mxCell>

        <!-- error -->
        <mxCell id="err" value="Error path&#10;SyntaxErrorException (parse/validate stages)&#10;ProcessingErrorException (evaluation stage)&#10;CyclicVariableReferenceException (variable cycle)&#10;→ see Error Handling Flow (08)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="560" width="320" height="130" as="geometry" />
        </mxCell>

        <!-- edges main chain -->
        <mxCell id="e0" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="success" style="endArrow=block;html=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec" style="endArrow=open;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="cache" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee" value="on failure" style="endArrow=open;html=1;dashed=1;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="s7" target="err"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Blue = input   Orange = parsing/validation   Purple = core engine step   Green = success   Yellow = cache   Red = error path" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
