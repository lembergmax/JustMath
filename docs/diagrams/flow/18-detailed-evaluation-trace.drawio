        <mxCell id="sh2" value="Action (rule applied)" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="170" y="230" width="470" height="34" as="geometry" /></mxCell>
