<mxfile host="app.diagrams.net" type="device">
  <diagram id="detailed-evaluation-trace" name="Detailed Evaluation Trace">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Detailed Evaluation Trace — evaluate(&quot;3 + 4 * 2 - ( 1 - 5 )&quot;)  →  15" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Step-by-step state of every data structure. Phase 1: PostfixParser.toPostfix converts infix tokens to RPN using the Shunting-Yard algorithm (operator stack + output queue). Phase 2: Evaluator.evaluate consumes the RPN with a single value stack. Stacks are written bottom→top; the rightmost element is the top (next pop). Precedences: + and - = 2, * and / = 3 (verified in ExpressionElements). Associativity: only ^ is right-associative; +,-,*,/ are left-associative. Binary operator application pops b first (top), then a, and pushes a∘b (verified in SimpleBinaryOperator.apply)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1500" height="80" as="geometry" />
        </mxCell>

        <!-- Tokenization -->
        <mxCell id="tok" value="Tokenizer.tokenize(&quot;3 + 4 * 2 - ( 1 - 5 )&quot;)  →  [ 3, +, 4, *, 2, -, (, 1, -, 5, ) ]   (all binary operators; no unary signs here)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="1500" height="40" as="geometry" />
        </mxCell>

        <!-- PHASE 1 heading -->
        <mxCell id="p1" value="Phase 1 — Shunting-Yard (PostfixParser.toPostfix)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="900" height="24" as="geometry" />
        </mxCell>

