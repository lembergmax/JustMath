        <!-- rule box -->
        <mxCell id="rules" value="Shunting-Yard pop rule (per incoming operator o):&#10;while top of stack is a FUNCTION, OR an operator with&#10;higher precedence than o, OR equal precedence and o is&#10;left-associative → pop top to output. Then push o.&#10;&#10;Factorial &quot;!&quot; is a postfix operator: appended to output&#10;immediately. ^ is the only right-associative operator." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="864" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="leg" value="Legend:  Blue token = operand pushed   Purple token = operator applied   Yellow = parenthesis / rule   Green = final result   Monospace columns show live data-structure state." style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="1290" width="1500" height="24" as="geometry" />
        </mxCell>
