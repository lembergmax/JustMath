<mxfile host="app.diagrams.net" type="device">
  <diagram id="mode-state-diagrams" name="Modes and States">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Modes &amp; State / Decision diagrams" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Four small decision/state views for the configurable modes and outcome types. All names verified against ErrorMode, TrigonometricMode, CalculatorResult and UnitElements.areCompatible." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="980" height="44" as="geometry" />
        </mxCell>

        <!-- ErrorMode -->
        <mxCell id="g1" value="ErrorMode (engine.setErrorMode)" style="swimlane;html=1;startSize=26;fillColor=none;strokeColor=#000;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="em_start" value="error formatted" style="ellipse;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g1">
          <mxGeometry x="20" y="70" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="em_raw" value="RAW&#10;technical English (technicalDetail)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666;" vertex="1" parent="g1">
          <mxGeometry x="200" y="40" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="em_uf" value="USER_FRIENDLY&#10;localized template from i18n bundle" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="g1">
          <mxGeometry x="200" y="100" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="em_e1" value="RAW" style="endArrow=block;html=1;fontSize=11;strokeColor=#666;" edge="1" parent="g1" source="em_start" target="em_raw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em_e2" value="USER_FRIENDLY" style="endArrow=block;html=1;fontSize=11;strokeColor=#d6b656;" edge="1" parent="g1" source="em_start" target="em_uf"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- TrigonometricMode -->
        <mxCell id="g2" value="TrigonometricMode (constructor / per call)" style="swimlane;html=1;startSize=26;fillColor=none;strokeColor=#000;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tm_in" value="trig fn input angle" style="ellipse;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g2">
          <mxGeometry x="20" y="70" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tm_deg" value="DEG&#10;convertAngle: degrees → radians, then BigDecimalMath" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="g2">
          <mxGeometry x="200" y="40" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tm_rad" value="RAD&#10;use angle directly (radians)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="g2">
          <mxGeometry x="200" y="100" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tm_e1" value="DEG (default)" style="endArrow=block;html=1;fontSize=11;strokeColor=#9673a6;" edge="1" parent="g2" source="tm_in" target="tm_deg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tm_e2" value="RAD" style="endArrow=block;html=1;fontSize=11;strokeColor=#9673a6;" edge="1" parent="g2" source="tm_in" target="tm_rad"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- CalculatorResult -->
        <mxCell id="g3" value="CalculatorResult&lt;T&gt; (sealed)" style="swimlane;html=1;startSize=26;fillColor=none;strokeColor=#000;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cr_in" value="evaluateSafe(...)" style="ellipse;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g3">
          <mxGeometry x="20" y="70" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cr_ok" value="Success&lt;T&gt;(value)&#10;value() present, isSuccess()=true" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g3">
          <mxGeometry x="200" y="40" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cr_fail" value="Failure&lt;T&gt;(error)&#10;error() present, valueOrThrow() throws" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g3">
          <mxGeometry x="200" y="100" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cr_e1" value="ok" style="endArrow=block;html=1;fontSize=11;strokeColor=#82b366;" edge="1" parent="g3" source="cr_in" target="cr_ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cr_e2" value="error" style="endArrow=block;html=1;fontSize=11;strokeColor=#b85450;" edge="1" parent="g3" source="cr_in" target="cr_fail"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Unit compatibility -->
        <mxCell id="g4" value="Unit conversion validity (UnitElements.areCompatible)" style="swimlane;html=1;startSize=26;fillColor=none;strokeColor=#000;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="uc_in" value="convert(from, to)" style="ellipse;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g4">
          <mxGeometry x="20" y="70" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc_ok" value="same unit group&#10;→ toBase → fromBase → UnitValue" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g4">
          <mxGeometry x="200" y="40" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="uc_bad" value="different group / unknown symbol&#10;→ UnitConversionException" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g4">
          <mxGeometry x="200" y="100" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="uc_e1" value="compatible" style="endArrow=block;html=1;fontSize=11;strokeColor=#82b366;" edge="1" parent="g4" source="uc_in" target="uc_ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="uc_e2" value="incompatible" style="endArrow=block;html=1;fontSize=11;strokeColor=#b85450;" edge="1" parent="g4" source="uc_in" target="uc_bad"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Blue = entry state   Green = success   Red = error   Purple = engine math   Yellow = localized   Grey = raw/technical" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1100" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
