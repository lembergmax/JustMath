<mxfile host="app.diagrams.net" type="device">
  <diagram id="caching-flow" name="Caching Flow">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Expression Token Cache (LRU)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="When the cache is enabled, CalculatorEngine caches the tokenized form of an expression to skip re-tokenizing. The cache is a synchronized LinkedHashMap with access-order LRU eviction (default capacity 128). Important: tokens are cached BEFORE variable substitution (the substitution mutates the token list), so postfix and results are NOT cached. Verified against CalculatorEngine.java." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="70" as="geometry" />
        </mxCell>

        <mxCell id="in" value="evaluate(expression[, variables])" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="260" height="44" as="geometry" />
        </mxCell>
        <mxCell id="norm" value="normalize key = replaceAbsSigns(expression)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="enabled" value="cache enabled?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="290" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="hit" value="lookupCache(key)&#10;hit?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="410" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="reuse" value="reuse cached List&lt;Token&gt;&#10;(copy before mutation)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="425" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tok" value="Tokenizer.tokenize(key)&#10;→ List&lt;Token&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="store" value="storeCache(key, tokens)&#10;(LRU eviction at capacity)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cont" value="continue: variable substitution → validate →&#10;postfix → evaluate  (see Pipeline 07)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="560" width="400" height="56" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="in" target="norm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="norm" target="enabled"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="yes" style="endArrow=block;html=1;strokeColor=#333;fontSize=11;" edge="1" parent="1" source="enabled" target="hit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="no → tokenize" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="enabled" target="tok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="hit" style="endArrow=block;html=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="hit" target="reuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="miss → tokenize" style="endArrow=block;html=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="hit" target="tok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="store" style="endArrow=block;html=1;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="tok" target="store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="reuse" target="cont"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="store" target="cont"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Blue = entry/continuation   Orange = normalization   Yellow = cache decision/store   Purple = tokenize   Green = cache hit reuse" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
