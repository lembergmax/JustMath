<mxfile host="app.diagrams.net" type="device">
  <diagram id="error-handling-flow" name="Error Handling Flow">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Error Handling Flow" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="A failure is classified into a CalculatorErrorCode (23 codes; categories Syntax / Argument / Math / Range / Processing), wrapped in a CalculatorError, and surfaced either as an exception (throwing API) or a CalculatorResult.Failure (safe API). CalculatorError.format(Locale, ErrorMode) renders the message: RAW = technical English; USER_FRIENDLY = localized template from the i18n bundle. Verified against errors/* and exceptions/*." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1050" height="64" as="geometry" />
        </mxCell>

        <mxCell id="src" value="Failure detected in pipeline&#10;(tokenize / validate / parse / evaluate)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="code" value="CalculatorErrorCode&#10;e.g. SYNTAX_UNMATCHED_PAREN,&#10;SYNTAX_WRONG_ARGUMENT_COUNT,&#10;PROCESSING_DIVISION_BY_ZERO,&#10;MATH_LOG_NON_POSITIVE, MATH_OVERFLOW" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cerr" value="CalculatorError  (record)&#10;code, params, technicalDetail, position" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- branch throwing vs safe -->
        <mxCell id="dec" value="Which API was called?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="380" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="throw" value="Throwing API (evaluate, …)&#10;→ SyntaxErrorException&#10;  or ProcessingErrorException&#10;(extends CalculatorException)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="280" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="result" value="Safe API (evaluateSafe, …)&#10;→ CalculatorResult.Failure(error)&#10;(sealed; vs. Success)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- format -->
        <mxCell id="fmt" value="CalculatorError.format(Locale, ErrorMode)" style="rhombus;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="540" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="ErrorMode.RAW&#10;→ technicalDetail (English, technical)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="420" y="540" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uf" value="ErrorMode.USER_FRIENDLY&#10;→ lookup template in ResourceBundle&#10;i18n.calculator_errors (+_en / _de),&#10;tiered: code key → category → generic;&#10;substitute {function},{operator},{position},…" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="420" y="650" width="520" height="100" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="classify" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="src" target="code"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="wrap" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="code" target="cerr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="cerr" target="dec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="throwing" style="endArrow=block;html=1;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="dec" target="throw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="safe" style="endArrow=block;html=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="dec" target="result"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="render message" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="result" target="fmt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;strokeColor=#666666;" edge="1" parent="1" source="fmt" target="raw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="fmt" target="uf"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Orange = detection   Red = error type/exception   Green = safe result   Blue = decision   Yellow = localized output   Grey = raw output" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="1100" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
