<mxfile host="app.diagrams.net" type="device">
  <diagram id="extension-add-unit" name="Extension: add a unit">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Extension Guide — add a unit" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="UnitRegistry is the single source of truth: its Javadoc states adding a unit means adding exactly one entry to the BUILT_IN list. Entries are created with the private define / defineFraction / defineReciprocal helpers, which build a ConversionFormula via ConversionFormulas (affine / linear / reciprocal). Verified against UnitRegistry.java and ConversionFormulas." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="64" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Step 1 — Add the Unit identifier&#10;Add the enum constant to the right group in Unit&#10;(e.g. Unit.Length.MY_UNIT). The group fixes the base unit&#10;and the compatibility check (areCompatible)." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Step 2 — Choose the conversion relationship to the base unit&#10;Linear w/ offset → ConversionFormulas.affine(scale, offset)&#10;Exact fraction   → linear(num, den)&#10;Reciprocal       → reciprocal(scale) / reciprocal(num, den)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="560" height="84" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Step 3 — Add one entry to UnitRegistry.BUILT_IN&#10;Use the matching helper:&#10;  define(unit, displayName, symbol, scale, offset)&#10;  defineFraction(unit, displayName, symbol, num, den)&#10;  defineReciprocal(...)&#10;Mark the group base unit with the base=true variant." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="354" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Step 4 — Verify&#10;parseUnit(symbol) resolves the new symbol; convert(...) routes&#10;value → toBase → fromBase automatically. Add a JUnit 5 test&#10;(see UnitConverterTest / UnitConversionPrecisionTest) asserting a&#10;known conversion and a precision case." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="474" width="560" height="100" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Affine formula: base = value · scale + offset; inverse value = (base − offset) / scale. Use a non-zero offset only for affine scales like Temperature (Celsius ↔ Fahrenheit/Kelvin). Symbols are case-sensitive and resolved longest-match-first. No other file needs editing — UnitElements, UnitConverter and UnitValue all read from the registry." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="280" height="300" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Blue = identifier   Orange = formula choice   Yellow = registry entry   Green = verify   Grey = guidance" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
