<mxfile host="app.diagrams.net" type="device">
  <diagram id="extension-add-function" name="Extension: add a function">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Extension Guide — add a math function" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Functions and operators are registered in the static initializer of ExpressionElements via concrete element types (OneArgumentFunction, TwoArgumentFunction, SimpleBinaryOperator, …) that wrap a BigNumber method reference. Adding a function = provide the computation on BigNumber, then register one entry. Verified against ExpressionElements.java (static {} block) and BigNumber.java." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="900" height="64" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Step 1 — Implement the computation&#10;Add a method on BigNumber (e.g. BigNumber myFn(MathContext, Locale)),&#10;delegating to a math.* helper class as the existing methods do." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Step 2 — Define the symbol constant&#10;Add the function/operator symbol (e.g. FUNC_MYFN = &quot;myfn&quot;) used as the&#10;registry key — match how FUNC_SQRT, OP_PLUS, … are declared." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Step 3 — Register in ExpressionElements static {}&#10;Add one entry of the matching element type:&#10;  new OneArgumentFunction(FUNC_MYFN, precedence, BigNumber::myFn)&#10;  (or TwoArgumentFunction / SimpleBinaryOperator / ThreeArgumentFunction / …)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Step 4 — (if needed) Tokenizer recognition&#10;Multi-argument / multi-char symbols may need an entry in the Tokenizer&#10;candidate tables so the symbol is lexed correctly." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Step 5 — Verify&#10;The Evaluator resolves the symbol through the registry automatically&#10;(element.apply(stack, ctx, trigMode, locale)). Add a JUnit 5 test&#10;asserting evaluate(&quot;myfn(...)&quot;) returns the expected BigNumber." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="560" height="84" as="geometry" />
        </mxCell>

        <mxCell id="note" value="No change is required in PostfixParser or Evaluator — both are registry-driven. Pick the element type by arity:&#10;1 arg → OneArgumentFunction · 2 args → TwoArgumentFunction · 3 args → ThreeArgumentFunction · variadic → UnlimitedArgumentFunction · binary op → SimpleBinaryOperator / BinaryOperator · trig (mode-aware) → OneArgumentTrigonometricFunction." style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="280" height="280" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeColor=#333;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:  Blue = compute   Orange = symbol/lexing   Purple = registration   Green = verify   Grey = guidance" style="text;html=1;fontSize=12;align=left;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
