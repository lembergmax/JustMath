<mxfile host="app.diagrams.net" type="device">
  <diagram id="extension-add-function" name="16 · Extension: add a function">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="banner" value="Extension Guide — Add a Math Function" style="rounded=1;arcSize=6;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=24;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=24;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Functions and operators are registered in the static initializer of ExpressionElements via concrete element types (OneArgumentFunction, TwoArgumentFunction, SimpleBinaryOperator, …) that wrap a BigNumber method reference. Adding a function = provide the computation on BigNumber, then register one entry. PostfixParser and Evaluator are registry-driven and need no change. Verified against ExpressionElements.java (static block) and BigNumber.java." style="text;html=1;fontColor=#475569;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="44" y="84" width="1416" height="56" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;Step 1 · Implement the computation logic&lt;/b&gt;&lt;br&gt;Write the actual math in a helper class in package com.mlprograms.justmath.bignumber.math (e.g. a static MyFnMath.myFn(BigNumber, MathContext, Locale)), like the existing math.* helpers do." style="rounded=1;arcSize=10;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="640" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Step 2 · Expose a method on BigNumber&lt;/b&gt;&lt;br&gt;Add a method on BigNumber (e.g. BigNumber myFn(MathContext, Locale)) that just delegates to the math.* helper class from Step 1, matching the existing BigNumber methods." style="rounded=1;arcSize=10;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="258" width="640" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Step 3 · Define the symbol constant&lt;/b&gt;&lt;br&gt;Add the function/operator symbol (e.g. FUNC_MYFN = &quot;myfn&quot;) used as the registry key — match how FUNC_SQRT, OP_PLUS, … are declared." style="rounded=1;arcSize=10;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="346" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Step 4 · Register in ExpressionElements static&#160;{ }&lt;/b&gt;&lt;br&gt;Add one entry of the matching element type:&lt;br&gt;new OneArgumentFunction(FUNC_MYFN, precedence, BigNumber::myFn)&lt;br&gt;(or TwoArgumentFunction / SimpleBinaryOperator / ThreeArgumentFunction / …)" style="rounded=1;arcSize=10;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="426" width="640" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Step 5 · (if needed) Tokenizer recognition&lt;/b&gt;&lt;br&gt;Multi-argument / multi-character symbols may need an entry in the Tokenizer candidate tables so the symbol is lexed correctly." style="rounded=1;arcSize=10;html=1;fillColor=#FFEDD5;strokeColor=#F97316;fontColor=#7C2D12;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="522" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;Step 6 · Verify&lt;/b&gt;&lt;br&gt;The Evaluator resolves the symbol through the registry automatically (element.apply(stack, ctx, trigMode, locale)). Add a JUnit 5 test asserting evaluate(&quot;myfn(...)&quot;) returns the expected BigNumber." style="rounded=1;arcSize=10;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="602" width="640" height="78" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Pick the element type by arity" style="swimlane;rounded=1;arcSize=4;html=1;startSize=30;fillColor=#64748B;strokeColor=#475569;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;swimlaneFillColor=#FFFFFF;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="170" width="640" height="510" as="geometry" />
        </mxCell>
        <mxCell id="noteb" value="1 arg → &lt;b&gt;OneArgumentFunction&lt;/b&gt;&lt;br&gt;2 args → &lt;b&gt;TwoArgumentFunction&lt;/b&gt;&lt;br&gt;3 args → &lt;b&gt;ThreeArgumentFunction&lt;/b&gt;&lt;br&gt;variadic → &lt;b&gt;UnlimitedArgumentFunction&lt;/b&gt;&lt;br&gt;binary op → &lt;b&gt;SimpleBinaryOperator&lt;/b&gt; / &lt;b&gt;BinaryOperator&lt;/b&gt;&lt;br&gt;1-arg op (prefix or postfix) → &lt;b&gt;UnaryOperator&lt;/b&gt; with &lt;b&gt;Position&lt;/b&gt; (POSTFIX e.g. factorial !, PREFIX e.g. unary -/+)&lt;br&gt;trig (mode-aware) → &lt;b&gt;OneArgumentTrigonometricFunction&lt;/b&gt;&lt;br&gt;polar/cartesian → &lt;b&gt;CoordinateFunction&lt;/b&gt;&lt;br&gt;constant → &lt;b&gt;Constant&lt;/b&gt; (π, e)&lt;br&gt;&lt;br&gt;&lt;b&gt;Precedence reference&lt;/b&gt; (from ExpressionElements):&lt;br&gt;+ , −  = 2&#160;&#160;·&#160;&#160;* , /  = 3&#160;&#160;·&#160;&#160;^ (right-assoc), sqrt = 4&#160;&#160;·&#160;&#160;unary +/− = 4&#160;&#160;·&#160;&#160;! = 5&lt;br&gt;&lt;br&gt;&lt;b&gt;Registration helpers&lt;/b&gt;&#160;register(element) → registry · registerUnary(element) → unaryRegistry" style="text;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;arcSize=8;spacingLeft=10;spacingTop=8;spacingRight=10;" vertex="1" parent="note">
          <mxGeometry x="14" y="40" width="612" height="454" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;rounded=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;rounded=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;rounded=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;rounded=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;rounded=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Legend:&#160;&#160;Blue = compute&#160;&#160;·&#160;&#160;Orange = symbol / lexing&#160;&#160;·&#160;&#160;Violet = registration&#160;&#160;·&#160;&#160;Green = verify&#160;&#160;·&#160;&#160;Grey = guidance" style="text;html=1;fontColor=#475569;fontSize=12;fontFamily=Helvetica;align=left;" vertex="1" parent="1">
          <mxGeometry x="44" y="700" width="700" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
